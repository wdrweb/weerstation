/ {
	chosen {};

	aliases {
		sensortp = &bmp280;
		sensorth = &si7021;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	bmp280: bmp280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
		status = "okay";
	};

	si7021: si7021@40 {
		compatible = "silabs,si7006";
		reg = <0x40>;
		status = "okay";
	};
};
